# GestArtes Frontend Configuration
# ================================
# 
# Para HTTP + HTTP simples (padrão localhost dev):
#   VITE_API_URL=http://localhost:3001
#   VITE_ENABLE_HTTPS=false
#
# Para HTTPS + HTTPS com certs (default abaixo):
#   VITE_API_URL=https://localhost:3001
#   VITE_ENABLE_HTTPS=true
#   + caminhos de certs

# API URL — aponta para o backend
VITE_API_URL=https://localhost:3001

# HTTPS — para dev com HTTPS no frontend dev server
VITE_ENABLE_HTTPS=true
VITE_SSL_KEY_PATH=../gestArtes-api/certs/gestartes.key
VITE_SSL_CERT_PATH=../gestArtes-api/certs/gestartes.crt